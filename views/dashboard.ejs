<!DOCTYPE html>
<html>

<head>

    <title>ISC SANEP</title>

    <style>

        body{
            font-family: Arial;
            background:#111;
            color:#fff;
            padding:20px;
        }

        .card{
            background:#222;
            padding:20px;
            margin-bottom:15px;
            border-radius:10px;
        }

    </style>

</head>

<body>

    <h1>ISC SANEP</h1>

    <div class="card">
        <h2>Total Imóveis</h2>
        <h1><%= total %></h1>
    </div>

    <div class="card">
        <h2>Visitados</h2>
        <h1><%= visitados %></h1>
    </div>

    <div class="card">
        <h2>Pendentes</h2>
        <h1><%= pendentes %></h1>
    </div>

    <div class="card">
        <h2>Leituras</h2>
        <h1><%= leituras %></h1>
    </div>

    <div class="card">
        <h2>Fotos</h2>
        <h1><%= fotos %></h1>
    </div>

</body>

</html>
